# Google Gemini API key from https://aistudio.google.com/app/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_CHAT_MODEL=gemini-2.0-flash

# Optional: Groq chat generation
# LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Optional: OpenAI API key (alternative to Gemini)
# OPENAI_API_KEY=your-openai-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-4-turbo
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHAT_API_KEY=change-me-for-chat-clients
CHAT_RATE_LIMIT_PER_MINUTE=60
INGEST_API_KEY=change-me-for-local-ingest

# Application settings
APP_NAME=Security & Compliance Copilot
API_HOST=127.0.0.1
API_PORT=8000

# Data directories
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=security_compliance_copilot

# Retrieval settings
TOP_K=8
RERANK_K=6
MAX_CONTEXT_CHARS=24000
MIN_RETRIEVAL_SCORE=0.15
MIN_GOOD_RESULTS=2
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
